<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Add Nunur Size to the Sale Order tree (list) view -->
        <record id="view_sale_order_tree_nunur" model="ir.ui.view">
            <field name="name">sale.order.tree.nunur</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <field name="nunur_size" position="after"/>
            </field>
        </record>

        <!-- Add Nunur Size to the Sale Order form view -->
        <record id="view_sale_order_form_nunur" model="ir.ui.view">
            <field name="name">sale.order.form.nunur</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_order']" position="after">
                    <field name="nunur_size"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
